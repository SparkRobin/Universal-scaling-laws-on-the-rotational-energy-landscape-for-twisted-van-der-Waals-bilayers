Cell[CellGroupData[{

Cell["\<\
AA stacking.  Considering moire rotation
Eq. S3\
\>", "Subtitle",
 CellChangeTimes->{{3.8878425046399555`*^9, 3.8878425089775815`*^9}, {
   3.9497855300201664`*^9, 3.9497855315810585`*^9}, {3.9497867502454166`*^9, 
   3.949786754143241*^9}, {3.9497889272638483`*^9, 3.949788942599472*^9}, 
   3.9497895813378735`*^9},ExpressionUUID->"a463eba6-31a3-45a3-8059-\
8045ee738972"],

Cell[CellGroupData[{

Cell["1. Parameters and hexagon area", "Section",ExpressionUUID->"c6bd098e-c576-445c-a09f-91744819fde5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.8878417286163125`*^9, 3.887841729401764*^9}},
 CellLabel->
  "In[157]:=",ExpressionUUID->"d0b1b802-6337-4975-ba8a-6e5a5826849a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"hexagonarea", "=", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{"Boole", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          RowBox[{"Sqrt", "[", "3", "]"}]}], "*", 
         RowBox[{"x", "/", "3"}]}], "-", "1"}], "<", "y"}], "&&", 
      RowBox[{"y", "<", 
       RowBox[{
        RowBox[{
         RowBox[{"Sqrt", "[", "3", "]"}], "*", 
         RowBox[{"x", "/", "3"}]}], "+", "1"}]}], "&&", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Sqrt", "[", "3", "]"}], "*", 
         RowBox[{"x", "/", "3"}]}], "-", "1"}], "<", "y"}], "&&", 
      RowBox[{"y", "<", 
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          RowBox[{"Sqrt", "[", "3", "]"}]}], "*", 
         RowBox[{"x", "/", "3"}]}], "+", "1"}]}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"Sqrt", "[", "3", "]"}]}], "/", "2"}], ",", 
      RowBox[{
       RowBox[{"Sqrt", "[", "3", "]"}], "/", "2"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"y", ",", 
      RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.7923437615490294`*^9, 3.792343763077243*^9}, {
  3.8878466601178102`*^9, 3.8878466612997565`*^9}, {3.88784673877821*^9, 
  3.887846777961053*^9}, {3.88784697022265*^9, 3.887847083138256*^9}},
 CellLabel->
  "In[158]:=",ExpressionUUID->"cc10d27d-0e54-4e8a-b92a-6d57a13f0689"],

Cell[BoxData[
 FractionBox[
  RowBox[{"3", " ", 
   SqrtBox["3"]}], "2"]], "Output",
 CellChangeTimes->{3.8879200273662415`*^9, 3.893207836814211*^9, 
  3.8957866893723416`*^9, 3.9497860580438013`*^9, 3.9497860974238644`*^9, 
  3.9497867806583395`*^9, 3.949789639734386*^9, 3.949789753561303*^9, 
  3.9497898243137407`*^9, 3.9497918111955366`*^9, 3.949799365051777*^9, 
  3.9498010045272245`*^9, 3.949821630405696*^9, 3.949822433542366*^9, 
  3.9498238985758457`*^9, 3.949823978822285*^9, 4.003285699872061*^9, 
  4.00328985990233*^9, 4.0034412238358736`*^9, 4.0034421989983673`*^9},
 CellLabel->
  "Out[158]=",ExpressionUUID->"177c1de2-33b2-484d-8453-0e2b14c81c49"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Integrate a general plane wave", "Section",ExpressionUUID->"2039f87b-093f-491b-81ef-8a07132513c8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"assum", "=", 
   RowBox[{
    RowBox[{"0", "<", "\[Theta]", "<", 
     FractionBox["\[Pi]", "3"]}], "&&", 
    RowBox[{"r", ">", "0"}], "&&", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}], "\[Element]", 
     TemplateBox[{},
      "Reals"]}]}]}], ";"}]], "Input",
 CellLabel->
  "In[159]:=",ExpressionUUID->"50199c1d-9375-4230-a851-ac89526dc79a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Integrate", " ", "the", " ", "original", " ", "cosine", " ", "wave", " ", 
    "over", " ", "the", " ", "entire", " ", 
    RowBox[{"hexagon", "."}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"hexWave", "[", 
    RowBox[{"kx_", ",", "ky_"}], "]"}], "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{"Cos", "[", 
        RowBox[{
         RowBox[{"kx", " ", "x"}], "+", 
         RowBox[{"ky", " ", "y"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Sqrt", "[", "3", "]"}]}], "/", "2"}], ",", 
         RowBox[{
          RowBox[{"Sqrt", "[", "3", "]"}], "/", "2"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          RowBox[{
           RowBox[{"Abs", "[", "x", "]"}], "/", 
           RowBox[{"Sqrt", "[", "3", "]"}]}]}], ",", 
         RowBox[{"1", "-", 
          RowBox[{
           RowBox[{"Abs", "[", "x", "]"}], "/", 
           RowBox[{"Sqrt", "[", "3", "]"}]}]}]}], "}"}], ",", 
       RowBox[{"GenerateConditions", "->", "False"}]}], "]"}], "/", 
     "hexagonarea"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{4.003441426927081*^9, 4.003441431928486*^9}, {
  4.003441463399032*^9, 4.003441481172107*^9}},
 CellLabel->
  "In[160]:=",ExpressionUUID->"6a7c51e1-4046-4323-802c-550faf5f64de"],

Cell[BoxData[
 FractionBox[
  RowBox[{"8", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "ky"}], " ", 
      RowBox[{"Cos", "[", 
       FractionBox[
        RowBox[{
         SqrtBox["3"], " ", "kx"}], "2"], "]"}], " ", 
      RowBox[{"Cos", "[", 
       FractionBox["ky", "2"], "]"}]}], "+", 
     RowBox[{"ky", " ", 
      RowBox[{"Cos", "[", "ky", "]"}]}], "+", 
     RowBox[{
      SqrtBox["3"], " ", "kx", " ", 
      RowBox[{"Sin", "[", 
       FractionBox[
        RowBox[{
         SqrtBox["3"], " ", "kx"}], "2"], "]"}], " ", 
      RowBox[{"Sin", "[", 
       FractionBox["ky", "2"], "]"}]}]}], ")"}]}], 
  RowBox[{
   RowBox[{"9", " ", 
    SuperscriptBox["kx", "2"], " ", "ky"}], "-", 
   RowBox[{"3", " ", 
    SuperscriptBox["ky", "3"]}]}]]], "Output",
 CellChangeTimes->{
  4.0034414330435877`*^9, {4.0034414647185535`*^9, 4.0034414826315756`*^9}, 
   4.003441646090294*^9, 4.0034421998765855`*^9},
 CellLabel->
  "Out[160]=",ExpressionUUID->"3ada5be6-c627-4aee-a4a2-1f5497f2850b"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Exact wave vector for p = 1", "Section",ExpressionUUID->"cf6b6ff2-ef1d-4d34-a2b4-f06a7bdecfb9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Exact", " ", "components", " ", "after", " ", 
    RowBox[{"simplification", "."}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"kx0", "=", 
     FractionBox[
      RowBox[{"4", " ", "\[Pi]", " ", "r", " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}]}], 
      SqrtBox["3"]]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ky0", "=", 
     FractionBox[
      RowBox[{"4", " ", "\[Pi]", " ", "r", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Cos", "[", "\[Theta]", "]"}], "-", "1"}], ")"}]}], 
      SqrtBox["3"]]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{4.003526142077529*^9, 
  4.003526146592988*^9}},ExpressionUUID->"2d3d851c-0753-4bab-a8c6-\
5aab1f4c190f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Complete AA result: Eq. S3", "Section",ExpressionUUID->"2ff46651-5707-41e7-a461-a13502014301"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Add", " ", "the", " ", "three", " ", "equal", " ", "plane"}], 
    "-", 
    RowBox[{"wave", " ", 
     RowBox[{"integrals", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{"hexAA", "[", 
    RowBox[{"\[Theta]_", ",", "r_"}], "]"}], "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"3", " ", 
      RowBox[{"hexWave", "[", 
       RowBox[{"kx0", ",", "ky0"}], "]"}]}], ",", "assum"}], 
    "]"}]}]}]], "Input",
 CellLabel->
  "In[163]:=",ExpressionUUID->"8436c203-ebe3-4f83-8001-d74873c73387"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", 
   RowBox[{"8", " ", 
    SuperscriptBox["\[Pi]", "2"], " ", 
    SuperscriptBox["r", "2"], " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"2", " ", 
       RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}]}]], 
  RowBox[{"3", " ", 
   SuperscriptBox[
    RowBox[{"Csc", "[", 
     FractionBox["\[Theta]", "2"], "]"}], "2"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Cos", "[", 
      FractionBox[
       RowBox[{"4", " ", "\[Pi]", " ", "r", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          RowBox[{"Cos", "[", "\[Theta]", "]"}]}], ")"}]}], 
       SqrtBox["3"]], "]"}], "-", 
     RowBox[{
      RowBox[{"Cos", "[", 
       FractionBox[
        RowBox[{"2", " ", "\[Pi]", " ", "r", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}], ")"}]}], 
        SqrtBox["3"]], "]"}], " ", 
      RowBox[{"Cos", "[", 
       RowBox[{"2", " ", "\[Pi]", " ", "r", " ", 
        RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "]"}]}], "-", 
     RowBox[{
      SqrtBox["3"], " ", 
      RowBox[{"Cot", "[", 
       FractionBox["\[Theta]", "2"], "]"}], " ", 
      RowBox[{"Sin", "[", 
       FractionBox[
        RowBox[{"2", " ", "\[Pi]", " ", "r", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}], ")"}]}], 
        SqrtBox["3"]], "]"}], " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"2", " ", "\[Pi]", " ", "r", " ", 
        RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "]"}]}]}], 
    ")"}]}]}]], "Output",
 CellChangeTimes->{4.003441228714106*^9, 4.003441490764736*^9, 
  4.0034416508228397`*^9, 4.0034422006745625`*^9},
 CellLabel->
  "Out[163]=",ExpressionUUID->"11c4fe58-734f-4af4-9e66-365ed1a51e00"]
}, Open  ]],

Cell["", "PageBreak",
 PageBreakBelow->True,ExpressionUUID->"52e48d7f-1a9e-49ab-948e-d41a4c0baa23"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. Complete AB result: Eq. S4", "Section",ExpressionUUID->"92b2d120-35bb-4c72-9be5-7664cc13533f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"hexAB", "[", 
   RowBox[{"\[Theta]_", ",", "r_"}], "]"}], "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "2"]}], " ", 
     RowBox[{"hexAA", "[", 
      RowBox[{"\[Theta]", ",", "r"}], "]"}]}], ",", "assum"}], 
   "]"}]}]], "Input",
 CellLabel->
  "In[164]:=",ExpressionUUID->"bcb65f59-d534-43dd-9566-671681262a93"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", 
   RowBox[{"16", " ", 
    SuperscriptBox["\[Pi]", "2"], " ", 
    SuperscriptBox["r", "2"], " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"2", " ", 
       RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}]}]], 
  RowBox[{"3", " ", 
   SuperscriptBox[
    RowBox[{"Csc", "[", 
     FractionBox["\[Theta]", "2"], "]"}], "2"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"Cos", "[", 
       FractionBox[
        RowBox[{"4", " ", "\[Pi]", " ", "r", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}], ")"}]}], 
        SqrtBox["3"]], "]"}]}], "+", 
     RowBox[{
      RowBox[{"Cos", "[", 
       FractionBox[
        RowBox[{"2", " ", "\[Pi]", " ", "r", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}], ")"}]}], 
        SqrtBox["3"]], "]"}], " ", 
      RowBox[{"Cos", "[", 
       RowBox[{"2", " ", "\[Pi]", " ", "r", " ", 
        RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "]"}]}], "+", 
     RowBox[{
      SqrtBox["3"], " ", 
      RowBox[{"Cot", "[", 
       FractionBox["\[Theta]", "2"], "]"}], " ", 
      RowBox[{"Sin", "[", 
       FractionBox[
        RowBox[{"2", " ", "\[Pi]", " ", "r", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}], ")"}]}], 
        SqrtBox["3"]], "]"}], " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"2", " ", "\[Pi]", " ", "r", " ", 
        RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "]"}]}]}], 
    ")"}]}]}]], "Output",
